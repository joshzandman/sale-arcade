{% comment %}
  Paste this before </body> in theme.liquid (or a custom liquid section).
  Logged-in customer first names show as a chat bubble over their NPC.
{% endcomment %}
{% if customer and customer.first_name != blank %}
  <script>
    document.cookie =
      "sale_arcade_name={{ customer.first_name | url_encode }}; path=/; max-age=2592000; SameSite=Lax";
  </script>
{% endif %}
